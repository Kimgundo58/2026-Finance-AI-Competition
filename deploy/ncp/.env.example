# deploy/ncp/.env 템플릿. 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 git 에서 제외된다.
# 시크릿 생성: openssl rand -hex 32
# - DB 비밀번호는 접속 URL 에 그대로 들어가므로 hex 문자열만 사용한다.
# - 주석은 값 뒤가 아니라 별도 줄에 쓴다.

# ── 도메인 ───────────────────────────────────────────────────────────
# 정식 도메인이 준비되기 전에는 공인 IP 기반 임시 주소를 쓴다. 예) 공인 IP 1.2.3.4 → 1-2-3-4.sslip.io
SUDDOE_DOMAIN=

# ── DB ───────────────────────────────────────────────────────────────
# postgres(superuser) 비밀번호. 복원·백업에만 사용하고 API 컨테이너에는 전달하지 않는다.
POSTGRES_PASSWORD=
# 앱 전용 롤 suddoe_app 비밀번호 (superuser 아님, RLS 적용 대상)
SUDDOE_APP_DB_PASSWORD=

# ── 앱 시크릿 ─────────────────────────────────────────────────────────
# /admin/* API 인증 토큰
SUDDOE_ADMIN_TOKEN=
# 데모 토큰(HS256) 서명 키. 비워 두면 공개 레포에 있는 개발용 기본값이 사용되어 토큰 위조가 가능하다.
# compose 는 이 값이 비어 있으면 기동하지 않는다.
SUDDOE_DEMO_SECRET=
# 기관 slug(HMAC) 서명 키. 값을 바꾸면 모든 기관 slug 가 바뀌어 기존에 공유한 기관 링크가 동작하지 않는다.
SUDDOE_SLUG_SECRET=

# ── 외부 서비스 ───────────────────────────────────────────────────────
# 프론트엔드(Vercel) origin 목록. API 도메인과 무관하므로 API 도메인을 바꿔도 수정하지 않는다.
SUDDOE_CORS=https://2026-finance-ai-competition-fronten.vercel.app,https://2026-finance-ai-competition-frontend-team-9ea8.vercel.app,https://2026-finance-ai-competition-frontend-git-main-team-9ea8.vercel.app
SUDDOE_JWKS_URL=https://ntjzekolrrrgkcacbpdx.supabase.co/auth/v1/.well-known/jwks.json
# LLM API 키. 비어 있으면 서버는 기동하지만 모든 판정이 판단불가로 반환된다.
# SUDDOE_LLM_API_KEY 가 비어 있으면 DASHSCOPE_API_KEY 를 쓴다.
SUDDOE_LLM_API_KEY=
DASHSCOPE_API_KEY=
# OpenAI 호환 API 주소. 비우면 DashScope 국제 리전. Runyour AI: https://api.runyour.ai/v1
SUDDOE_LLM_BASE_URL=
# 모델 ID 는 BASE_URL 의 라우터 기준이다. Runyour AI: gemini/gemini-3.8-flash · qwen/qwen3.8-flash / DashScope: qwen3.7-plus · qwen3.8-flash
# 판정 외 모든 단계의 기본 모델(2026-11-17 qwen3.7-plus → Gemini 3.8 Flash). Gemini · Sonnet · GPT 는 Runyour 경유로만 부른다
# (위 SUDDOE_LLM_BASE_URL=https://api.runyour.ai/v1 필요. DashScope 를 쓰면 qwen3.7-plus · qwen3.8-flash 로 두고 SUDDOE_JUDGE_MODELS 를 비운다)
SUDDOE_QWEN_MODEL=gemini/gemini-3.8-flash
SUDDOE_QWEN_FALLBACK_MODEL=qwen/qwen3.8-flash
# ④ 판정 앙상블 모델(쉼표 구분, 순서 = 대표 출력 우선순위). 빈 값이면 SUDDOE_QWEN_MODEL 하나로 판정한다(되돌리기)
SUDDOE_JUDGE_MODELS=anthropic/claude-sonnet-5-5,gemini/gemini-3.8-flash,openai/gpt-6.1-terra

# 새 온톨로지 판정 경로를 켤 사업의 정확한 이름을 쉼표로 구분한다. 빈 값은 기존 경로다.
# 예: SUDDOE_ONTOLOGY_PROGRAMS=모두의 창업 프로젝트,예비창업패키지
SUDDOE_ONTOLOGY_PROGRAMS=
# 공개 검색 키 값은 이 파일에 넣지 않는다. `apick_secrets` 볼륨의 `apick.key`에 별도로 보관한다.
# API 컨테이너 UID 10001이 읽을 수 있어야 하며, 파일이 없으면 공개 검색 요청만 실패한다.

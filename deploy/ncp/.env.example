# deploy/ncp/.env 템플릿. 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 git 에서 제외된다.
# 시크릿 생성: openssl rand -hex 32
# - DB 비밀번호는 접속 URL 에 그대로 들어가므로 hex 문자열만 사용한다.
# - 주석은 값 뒤가 아니라 별도 줄에 쓴다.

# ── 도메인 ───────────────────────────────────────────────────────────
# 정식 도메인이 준비되기 전에는 공인 IP 기반 임시 주소를 쓴다. 예) 공인 IP 1.2.3.4 → 1-2-3-4.sslip.io
SUDDOE_DOMAIN=

# ── DB ───────────────────────────────────────────────────────────────
# postgres(superuser) 비밀번호. 복원·백업에만 사용하고 API 컨테이너에는 전달하지 않는다.
POSTGRES_PASSWORD=
# 앱 전용 롤 suddoe_app 비밀번호 (superuser 아님, RLS 적용 대상)
SUDDOE_APP_DB_PASSWORD=

# ── 앱 시크릿 ─────────────────────────────────────────────────────────
# /admin/* API 인증 토큰
SUDDOE_ADMIN_TOKEN=
# 데모 토큰(HS256) 서명 키. 비워 두면 공개 레포에 있는 개발용 기본값이 사용되어 토큰 위조가 가능하다.
# compose 는 이 값이 비어 있으면 기동하지 않는다.
SUDDOE_DEMO_SECRET=
# 기관 slug(HMAC) 서명 키. 값을 바꾸면 모든 기관 slug 가 바뀌어 기존에 공유한 기관 링크가 동작하지 않는다.
SUDDOE_SLUG_SECRET=

# ── 외부 서비스 ───────────────────────────────────────────────────────
# 프론트엔드(Vercel) origin 목록. API 도메인과 무관하므로 API 도메인을 바꿔도 수정하지 않는다.
SUDDOE_CORS=https://2026-finance-ai-competition-fronten.vercel.app,https://2026-finance-ai-competition-frontend-team-9ea8.vercel.app,https://2026-finance-ai-competition-frontend-git-main-team-9ea8.vercel.app
SUDDOE_JWKS_URL=https://ntjzekolrrrgkcacbpdx.supabase.co/auth/v1/.well-known/jwks.json
# DashScope(Qwen) API 키. 비어 있으면 서버는 기동하지만 모든 판정이 판단불가로 반환된다.
DASHSCOPE_API_KEY=
SUDDOE_QWEN_MODEL=qwen3.7-plus

# PostgreSQL 17 + pgvector 기존 이미지에 Apache AGE 1.6.0(PG17 안정판)을 추가한다.
# Apache 공식 소스와 SHA-512: https://archive.apache.org/dist/age/PG17/1.6.0/
# 개발 패키지는 빌드 단계에만 두고, 최종 이미지의 PostgreSQL 데이터는 건드리지 않는다.
FROM pgvector/pgvector:pg17@sha256:ac08538c6f8b9904c33c8224c5e5706dbe760aca29db1d096972b4052c22a75d AS age-build

USER root
# 헤더가 서버와 minor 가 다르면 age.so 가 로드되지 않는다(예: 17.12 헤더 → 17.11 서버 heap_datum_check 없음).
# 그래서 dev 헤더를 base 이미지 서버 패키지와 같은 버전으로 고정하고, 본 저장소에서 빠진 옛 버전은 PGDG 아카이브(같은 서명 키)에서 받는다.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && echo "deb [ signed-by=/usr/local/share/keyrings/postgres.gpg.asc ] https://apt-archive.postgresql.org/pub/repos/apt bookworm-pgdg-archive main" > /etc/apt/sources.list.d/pgdg-archive.list \
 && apt-get update \
 && PG_SERVER_VERSION="$(dpkg-query -W -f='${Version}' postgresql-17)" \
 && apt-get install -y --no-install-recommends build-essential flex bison wget "postgresql-server-dev-17=${PG_SERVER_VERSION}" \
 && test "$(dpkg-query -W -f='${Version}' postgresql-server-dev-17)" = "${PG_SERVER_VERSION}" \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /tmp/age
RUN wget -q -O age.tar.gz https://archive.apache.org/dist/age/PG17/1.6.0/apache-age-1.6.0-src.tar.gz \
 && echo 'b3021cc6bb0d88a209066596a7f31fb848e4281f2ed719c105f301c7e8017969f5b472fc4b55261105b36ab3dae788e00c4bfff2febe1f147b3b13cddcead2aa  age.tar.gz' | sha512sum -c - \
 && tar -xzf age.tar.gz --strip-components=1 \
 && /usr/lib/postgresql/17/bin/pg_config --version | grep -E '^PostgreSQL 17([. ]|$)' \
 && make PG_CONFIG=/usr/lib/postgresql/17/bin/pg_config \
 && make PG_CONFIG=/usr/lib/postgresql/17/bin/pg_config DESTDIR=/age-install install

FROM pgvector/pgvector:pg17@sha256:ac08538c6f8b9904c33c8224c5e5706dbe760aca29db1d096972b4052c22a75d
COPY --from=age-build /age-install/usr/lib/postgresql/17/lib/age.so /usr/lib/postgresql/17/lib/age.so
COPY --from=age-build /age-install/usr/lib/postgresql/17/lib/bitcode/age/ /usr/lib/postgresql/17/lib/bitcode/age/
COPY --from=age-build /age-install/usr/lib/postgresql/17/lib/bitcode/age.index.bc /usr/lib/postgresql/17/lib/bitcode/age.index.bc
COPY --from=age-build /age-install/usr/share/postgresql/17/extension/age.control /usr/share/postgresql/17/extension/age.control
COPY --from=age-build /age-install/usr/share/postgresql/17/extension/age--1.6.0.sql /usr/share/postgresql/17/extension/age--1.6.0.sql
# 비수퍼유저는 PostgreSQL이 허용하는 $libdir/plugins/age 경로로 LOAD한다.
RUN mkdir -p /usr/lib/postgresql/17/lib/plugins \
 && ln -s ../age.so /usr/lib/postgresql/17/lib/plugins/age.so \
 && ! ldd /usr/lib/postgresql/17/lib/age.so | grep -q 'not found'

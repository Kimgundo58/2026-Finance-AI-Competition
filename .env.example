# 써도돼요 — 환경변수 «이름표»다. 값은 여기에 적지 않는다.
# 실제 값은 Secret Manager / Cloud Run 콘솔에 넣는다. .env 는 .dockerignore 가 막는다.
#
# 형식:  이름=            # 필수/선택 · 기본값 · 이 값이 무엇을 바꾸는가

# ── 필수 ─────────────────────────────────────────────────────────────
SUDDOE_DSN=                # 필수 · 기본은 로컬 개발 DSN(server/_common.py:20) · 비우면 컨테이너가 자기 안의 없는 DB 를 보고 접속 실패한다
SUDDOE_MOCK=               # 필수 · 기본 1(목업!) · 0 이어야 진짜 DB·판정을 탄다. Dockerfile 이 0 으로 덮지만 배포에서 다시 명시한다
SUDDOE_ADMIN_TOKEN=        # 필수 · 기본 없음 · /admin/* (워밍업·가드 상태)의 열쇠. 비면 관리 경로가 전부 막힌다
VLLM_URL=                  # 필수 · 기본 http://localhost:8000 · RunPod vLLM 주소. 틀리면 모든 판정이 「판단불가」로 닫힌다
SUDDOE_CORS=               # 필수 · 기본 http://localhost:3000,http://localhost:5173 · 배포 프론트 도메인을 넣지 않으면 브라우저가 응답을 버린다

# ── 선택: 모델 ───────────────────────────────────────────────────────
VLLM_MODEL=                # 선택 · 기본 Qwen/Qwen3-32B-AWQ · 호출 ①④ 가 쓰는 모델 이름 (vLLM 에 뜬 이름과 같아야 한다)
VLLM_MODEL_1=              # 선택 · 기본 없음(= VLLM_MODEL) · 정규화(①)만 다른 모델로 돌릴 때

# ── 선택: 비용 방어 (main.py 비용가드) ──────────────────────────────
SUDDOE_DAILY_CAP=          # 선택 · 기본 2000 · 하루 총 판정 호출 상한. 넘으면 거절한다
SUDDOE_IP_HOURLY=          # 선택 · 기본 60 · IP 당 시간당 상한. 한 사람이 캡을 다 먹는 걸 막는다
SUDDOE_CACHE_TTL=          # 선택 · 기본 900(초) · 같은 질문 재사용 창. 심사위원이 같은 예시를 누를 때 GPU 를 아낀다
SUDDOE_CACHE_MAX=          # 선택 · 기본 512 · 캐시 항목 수 상한(메모리)
SUDDOE_OPEN_FROM=          # 선택 · 기본 없음(항상 개방) · 심사 개방 시작. 창 밖이면 GPU 호출 자체가 안 나간다
SUDDOE_OPEN_UNTIL=         # 선택 · 기본 없음(항상 개방) · 심사 개방 종료

# ── 선택: 동작 조절 ──────────────────────────────────────────────────
SUDDOE_PORT=               # 선택 · 기본 8080 · `python server/main.py` 직접 실행용. Cloud Run 은 $PORT 를 준다
SUDDOE_HOST=               # 선택 · 기본 127.0.0.1 · 위와 같음. 컨테이너 CMD 는 0.0.0.0 을 직접 준다
PORT=                      # 선택 · 기본 8080 · Cloud Run 이 «주입»한다. 직접 설정 금지(설정하면 플랫폼과 어긋난다)
SUDDOE_JUDGE_HEARTBEAT_SEC=# 선택 · 기본 12(초) · SSE 주석 하트비트 주기. 프록시 유휴 타임아웃보다 짧아야 연결이 안 끊긴다
SUDDOE_PROGRAM_TTL=        # 선택 · 기본 300(초) · 사업명 목록 캐시 수명
SUDDOE_L3_DIR=             # 선택 · 기본 <repo>/_l3_업로드 · L3 원본 저장 위치. Cloud Run 은 디스크가 휘발이고 메모리를 먹는다
SUDDOE_GATE_B=             # 선택 · 기본 0.0 · 검색 게이트 B 임계. 판정 결과가 바뀐다 — 평가 없이 만지지 않는다
SUDDOE_GATE_C=             # 선택 · 기본 0.15 · 게이트 C 격차. 위와 같다
SUDDOE_VLLM_SELF_HOSTED=   # 선택 · 기본 1 · 1 이면 임대 GPU 를 「우리 것」으로 본다. 0 이면 외부 API 로 간주해 사실축 호출을 막는다
SUDDOE_ALLOW_EXTERNAL=     # 선택 · 기본 없음(=금지) · 1 로 켜면 외부 API 호출이 열린다. 🔴 CLAUDE.md 확정 원칙 위반이다 — 켜지 않는다

# ── 컨테이너가 이미 박아둔 것 (다시 줄 필요 없다) ───────────────────
# HF_HOME=/opt/hf · HF_HUB_OFFLINE=1 · TRANSFORMERS_OFFLINE=1
#   모델은 빌드에서 굽는다. OFFLINE 을 끄면 콜드스타트에 HF 왕복이 얹힌다

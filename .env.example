# 써도돼요 API 서버 환경변수 목록.
#
# 서버는 프로세스 환경변수만 읽는다. 이 파일을 .env 로 복사해도 자동으로 로드되지 않는다.
# 로컬에서는 셸에서 export(PowerShell 은 $env:이름='값')로 설정하거나
# `docker run --env-file` 처럼 env 파일을 읽는 도구로 넘긴다.
# 운영(NCP VM)의 값은 deploy/ncp/.env 에 있고 deploy/ncp/docker-compose.yml 이 컨테이너에 전달한다.
#
# 형식: 설명은 키 위의 주석 줄에 쓴다. 값 뒤에 주석을 붙이면 주석까지 값이 된다.
# 기본값으로 충분한 키는 주석 처리해 둔다. 빈 값(KEY=)은 코드 기본값을 덮어써
# 숫자 변환이 실패할 수 있으므로 쓰지 않는다.
#
# 2026-11-02 에 바뀐 키는 옛 이름(SUDDOE_ORG_PARAM, SUDDOE_GATE_B 등)도 폴백으로 읽는다. 구 이름 호환(제거 예정: 다음 릴리스)
# 새 이름과 옛 이름이 함께 있으면 새 이름이 우선한다.

# ── 필수 (운영) ──────────────────────────────────────────────────────
# PostgreSQL 접속 문자열. 운영은 비특권 롤 suddoe_app 으로 접속한다(RLS 정책이 적용된다).
# 기본값: 로컬 개발 DB (postgresql://postgres:devpw@localhost:5432/suddoe)
# SUDDOE_DSN=postgresql://suddoe_app:<비밀번호>@localhost:5432/suddoe

# 1 이면 DB·LLM 없이 고정 JSON 으로 응답한다(mock 모드). 설정하지 않으면 live 모드다.
# mock 모드인데 SUDDOE_JWKS_URL 이나 SUDDOE_ADMIN_TOKEN 이 있으면 배포 설정 실수로 보고 시작하지 않는다(RuntimeError).
# SUDDOE_MOCK=1

# /admin/* API 인증 토큰. 없으면 /admin/* 는 모두 거부된다.
# SUDDOE_ADMIN_TOKEN=<openssl rand -hex 32>

# 허용할 프론트엔드 origin(쉼표 구분). 기본값: http://localhost:3000,http://localhost:5173
# SUDDOE_CORS=https://example.vercel.app

# Supabase JWKS 주소. 없으면 토큰 검증이 503 으로 실패한다.
# SUDDOE_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json

# 데모 토큰(HS256) 서명 키. live 모드에서 없으면 데모 세션 발급(POST /api/demo/session)은 503, 데모 토큰은 401 이다.
# mock 모드에서만 코드에 공개된 개발용 기본값을 쓴다.
# SUDDOE_DEMO_SECRET=<openssl rand -hex 32>

# 기관 slug(HMAC) 서명 키. 바꾸면 기존에 공유한 기관 링크가 모두 무효가 된다.
# SUDDOE_SLUG_SECRET=<openssl rand -hex 32>

# 1 이면 클라이언트가 보낸 ?org_id= 파라미터(검증되지 않은 값)를 받는다. 기본값: 0(무시). 운영은 설정하지 않는다.
# SUDDOE_ALLOW_ORG_PARAM=1

# ── LLM (OpenAI 호환 API, 기본값 DashScope Qwen) ──────────────────────
# LLM API 키. 없으면 서버는 기동하지만 모든 판정이 판단불가로 반환된다.
# SUDDOE_LLM_API_KEY 가 비어 있으면 DASHSCOPE_API_KEY(DashScope 국제 리전 키)를 읽는다.
# SUDDOE_LLM_API_KEY=
# DASHSCOPE_API_KEY=

# OpenAI 호환 API 주소. 기본값: DashScope 국제 리전. Runyour AI 라우터는 https://api.runyour.ai/v1
# 라우터를 바꾸면 모델 ID 도 그 라우터 기준으로 넣는다(예: qwen/qwen3.7-plus).
# SUDDOE_LLM_BASE_URL=

# 기본 모델. 기본값: qwen3.7-plus
# SUDDOE_QWEN_MODEL=qwen3.7-plus

# 기본 모델 호출이 실패했을 때 쓰는 폴백 모델. 기본값: qwen3.8-flash
# SUDDOE_QWEN_FALLBACK_MODEL=qwen3.8-flash

# 판정 호출의 출력 토큰 상한. 기본값: 1500
# SUDDOE_JUDGE_MAX_TOKENS=1500

# 확인 질문 작성 모델. 비어 있으면 SUDDOE_QWEN_MODEL 을 쓴다.
# SUDDOE_QUESTION_MODEL=

# 확인 질문 LLM 제한 시간(초). 프론트 대기 25초보다 짧게 둔다. 기본값: 20
# SUDDOE_QUESTION_TIMEOUT=20

# 0 이면 확인 질문을 내지 않고 답변도 판정에 넣지 않는다(되돌리기용). 기본값: 1
# SUDDOE_JUDGE_ANSWERS=1

# 온톨로지 경로(코드 게이트 + 문맥 구성)로 판정할 사업명. 쉼표로 구분한다. corpus.norms 에 행이 있어야 켜진다.
# 비우면 모두 옛 경로다(되돌리기). 기본값: 비어 있음
# SUDDOE_ONTOLOGY_PROGRAMS=

# 질의 변환(온톨로지 경로의 /api/normalize) 모델. 비어 있으면 SUDDOE_QWEN_MODEL 을 쓴다. 정확도 · 지연 측정 뒤 정한다.
# SUDDOE_QUERY_MODEL=

# ── 판정 동작 ────────────────────────────────────────────────────────
# 검색 최소 유사도(게이트 B): dense 코사인 최고값이 이 값 미만이면 판단불가. 기본값: 0.0
# SUDDOE_RETRIEVAL_MIN_SIMILARITY=0.0

# 비목 후보 최소 격차(게이트 C): 비목 후보 1·2위 신뢰도 차이가 이 값 미만이면 후보를 함께 반환한다. 기본값: 0.15
# SUDDOE_CATEGORY_MIN_MARGIN=0.15

# 1 이면 검색에 사업 필터를 적용한다. 기본값: 1
# SUDDOE_PROGRAM_FILTER=1

# 1 이면 기동 시 임베딩 모델을 동기로 로드해 첫 요청이 모델 로딩 지연을 겪지 않게 한다. 기본값: 1
# SUDDOE_WARMUP_ON_START=1

# 판정 1건의 전체 시간 상한(초). 넘으면 판단불가로 반환한다. 기본값: 180
# SUDDOE_JUDGE_DEADLINE_SEC=180

# 판정 SSE 하트비트 주기(초). 기본값: 12
# SUDDOE_JUDGE_HEARTBEAT_SEC=12

# ── 비용 제한 ────────────────────────────────────────────────────────
# 하루 판정 호출 상한. 기본값: 2000
# SUDDOE_DAILY_JUDGE_LIMIT=2000

# IP 당 시간당 요청 상한. 기본값: 60
# SUDDOE_IP_HOURLY_LIMIT=60

# 정규화·판정 응답 캐시 TTL(초). 기본값: 900
# SUDDOE_RESPONSE_CACHE_TTL=900

# 메모리 캐시(게스트 요청용) 항목 수 상한. 기본값: 512
# SUDDOE_RESPONSE_CACHE_MAX=512

# 서비스 운영 기간(ISO 8601). 기간 밖이면 LLM 을 호출하지 않고 429 를 반환한다. 비우면 제한 없음.
# SUDDOE_SERVICE_START=2026-11-01T00:00:00+09:00
# SUDDOE_SERVICE_END=2026-12-31T23:59:59+09:00

# ── 캐시 TTL (DB 조회 결과) ──────────────────────────────────────────
# 사업명 목록 캐시 TTL(초). 기본값: 300
# SUDDOE_PROGRAM_TTL=300

# 체크항목·심층질문 표 캐시 TTL(초). 기본값: 300
# SUDDOE_CHECK_ITEM_TTL=300

# 판정 캐시 무효화용 데이터 버전 해시(룰·코퍼스 상태) 캐시 TTL(초). 기본값: 300
# SUDDOE_DATA_VERSION_TTL=300

# ── L3 업로드 ────────────────────────────────────────────────────────
# 업로드 원본 저장 위치. 기본값: <repo>/_l3_업로드
# SUDDOE_L3_DIR=/app/_l3_업로드

# HWP 변환에 쓰는 LibreOffice(soffice) 실행 파일 경로. 기본값: PATH 와 표준 설치 경로에서 찾는다.
# SOFFICE_BIN=/usr/bin/soffice

# 스캔본 PDF(텍스트 레이어 없음)를 읽는 네이버클라우드 CLOVA OCR(General). URL·시크릿이 둘 다 있어야 켜진다.
# 없으면 스캔본 업로드는 실패(스캔본)로 기록한다. 쪽당 1회 호출로 과금된다(scripts/clova_ocr.py).
# SUDDOE_OCR_URL: 콘솔 CLOVA OCR 도메인 → API Gateway 연동의 APIGW Invoke URL(/general 까지)
# SUDDOE_OCR_SECRET: 같은 화면의 Secret Key(X-OCR-SECRET 헤더)
# SUDDOE_OCR_MAX_PAGES: 문서당 OCR 쪽수 상한. 넘으면 호출하지 않고 실패(쪽수초과). 기본값: 100
# SUDDOE_OCR_URL=
# SUDDOE_OCR_SECRET=
# SUDDOE_OCR_MAX_PAGES=100

# ── L1·L2 규정 적재 API (/admin/documents) ──────────────────────────
# 적재 전용 접속 문자열(롤 suddoe_ingest, db/migrations/2026-11-01_corpus_ingest.sql). 없으면 적재 API 만 503 이다.
# SUDDOE_INGEST_DSN=postgresql://suddoe_ingest:<비밀번호>@localhost:5432/suddoe

# 업로드 원본을 파싱이 끝날 때까지 두는 폴더. 파싱 뒤 지운다. 기본값: <임시 폴더>/suddoe_corpus_upload
# SUDDOE_INGEST_DIR=/tmp/suddoe_corpus_upload

# ── 인증·데모 세션 ───────────────────────────────────────────────────
# Supabase JWT audience. 기본값: authenticated
# SUDDOE_JWT_AUD=authenticated

# JWKS 캐시 TTL(초). 기본값: 600
# SUDDOE_JWKS_TTL=600

# 데모 토큰 수명(초). 기본값: 7200
# SUDDOE_DEMO_TOKEN_TTL=7200

# 데모 세션(체험용 임시 기관)의 사업명. 기본값: 예비창업패키지
# SUDDOE_DEMO_PROGRAM=예비창업패키지

# 동시에 유지할 데모 세션 수 상한. 기본값: 200
# SUDDOE_DEMO_MAX_SESSIONS=200

# 데모 데이터 보존 기간(초). 기본값: 86400
# SUDDOE_DEMO_RETENTION_SEC=86400

# 한 요청에서 정리하는 만료 데모 데이터의 최대 건수. 기본값: 50
# SUDDOE_DEMO_PURGE_LIMIT=50

# ── 서버 직접 실행 ───────────────────────────────────────────────────
# `python server/main.py` 로 직접 실행할 때의 주소. uvicorn 이나 컨테이너에서는 쓰지 않는다.
# SUDDOE_HOST=127.0.0.1
# SUDDOE_PORT=8080

# 컨테이너 포트. Dockerfile CMD 가 읽는다. 기본값: 8080
# PORT=8080

# 컨테이너 이미지에 고정된 값(설정하지 않는다): HF_HOME=/opt/hf, HF_HUB_OFFLINE=1, TRANSFORMERS_OFFLINE=1

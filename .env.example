# 써도돼요 — 환경변수 이름표. 값은 여기에 적지 않는다(Secret Manager / Cloud Run 콘솔).
# 형식:  이름=            # 필수/선택 · 기본값 · 뜻

# ── 필수 ─────────────────────────────────────────────────────────────
SUDDOE_DSN=                # 필수 · 기본 로컬 개발 DSN · Cloud SQL 접속 문자열
SUDDOE_MOCK=               # 필수 · 기본 1(목업) · 0 이어야 실 DB·판정을 탄다
SUDDOE_ADMIN_TOKEN=        # 필수 · 기본 없음 · /admin/* 열쇠
SUDDOE_CORS=               # 필수 · 기본 localhost:3000,5173 · 배포 프론트 도메인
SUDDOE_JWKS_URL=           # 필수 · 기본 빈값 · Supabase JWKS 주소. 비면 토큰 검증 503
SUDDOE_DEMO_SECRET=        # 필수 · 기본 개발용 비밀 · 데모 토큰 HS256 서명키
SUDDOE_SLUG_SECRET=        # 필수 · 기본 개발용 비밀 · 기관 slug 서명키
SUDDOE_ORG_PARAM=          # 필수 · 기본 1 · 0 이어야 자기신고 org_id 파라미터를 막는다

# ── LLM ───────────────────────────────────────────────────────────────
SUDDOE_LLM=                # 선택 · 기본 vllm · 운영은 qwen(DashScope). vllm 이면 VLLM_URL 필요
DASHSCOPE_API_KEY=         # qwen 일 때 필수 · DashScope 국제판 키
SUDDOE_QWEN_MODEL=         # 선택 · 기본 qwen3.7-plus
SUDDOE_QWEN_FALLBACK_MODEL=# 선택 · 기본 qwen3.8-flash
VLLM_URL=                  # vllm 일 때 필수 · 기본 http://localhost:8000
VLLM_MODEL=                # 선택 · 기본 Qwen/Qwen3-32B-AWQ · vLLM 에 뜬 이름과 같아야 한다
VLLM_MODEL_1=              # 선택 · 정규화(①)만 다른 모델로 돌릴 때
SUDDOE_LLM_STREAM=         # 선택 · 기본 1 · 정규화 스트리밍
SUDDOE_LLM_STREAM_IDLE=    # 선택 · 기본 60(초) · 스트리밍 조각 사이 최대 공백
SUDDOE_JUDGE_MAX_TOKENS=   # 선택 · 기본 1500 · 판정 출력 토큰 상한
SUDDOE_SCHEMA_ORDER=       # 선택 · 기본 S0 · 판정 스키마 필드 순서 변형(S0/S1)
SUDDOE_VLLM_SELF_HOSTED=   # 선택 · 기본 1 · 0 이면 vLLM 을 외부 API 로 간주
SUDDOE_ALLOW_EXTERNAL=     # 선택 · 기본 없음 · 1 이면 비전 API 등 외부 호출 허용

# ── 판정 동작 ─────────────────────────────────────────────────────────
SUDDOE_GATE_B=             # 선택 · 기본 0.0 · 검색 게이트 B 임계
SUDDOE_GATE_C=             # 선택 · 기본 0.15 · 비목 후보 1·2위 신뢰도 격차
SUDDOE_PROGRAM_FILTER=     # 선택 · 기본 1 · 검색에 사업 필터 적용
SUDDOE_ROWSPLIT=           # 선택 · B3 참조 확장 블록의 표 행 분해
SUDDOE_WARMUP_ON_START=    # 선택 · 기본 1 · 기동 시 임베딩 동기 워밍업

# ── 비용 방어 ─────────────────────────────────────────────────────────
SUDDOE_DAILY_CAP=          # 선택 · 기본 2000 · 하루 판정 호출 상한
SUDDOE_IP_HOURLY=          # 선택 · 기본 60 · IP 당 시간당 상한
SUDDOE_CACHE_TTL=          # 선택 · 기본 900(초) · 판정 캐시 수명
SUDDOE_CACHE_MAX=          # 선택 · 기본 512 · 인메모리 캐시 항목 수
SUDDOE_OPEN_FROM=          # 선택 · 개방 시작 시각. 창 밖이면 LLM 호출 안 함
SUDDOE_OPEN_UNTIL=         # 선택 · 개방 종료 시각

# ── L3 업로드 ─────────────────────────────────────────────────────────
SUDDOE_L3_DIR=             # 선택 · 기본 <repo>/_l3_업로드 · 원본 저장 위치
SUDDOE_L3_READER=          # 선택 · 기본 vlm · 스캔본 판독기(vlm | docai)
SUDDOE_ALLOW_DOCAI=        # 선택 · Document AI 호출 허용
SUDDOE_DOCAI_PROJECT=      # docai 일 때 필수
SUDDOE_DOCAI_LOCATION=     # docai 일 때 필수
SUDDOE_DOCAI_PROCESSOR_ID= # docai 일 때 필수
SUDDOE_VLM_MODEL=          # 선택 · 비전 판독 모델
SUDDOE_VLM_CACHE_DIR=      # 선택 · 판독 결과 캐시
SUDDOE_L3_ITEM_ORDER=      # 선택 · 기본 off · L3 조문을 비목순으로 정렬

# ── 인증·데모 ─────────────────────────────────────────────────────────
SUDDOE_JWT_AUD=            # 선택 · 기본 authenticated
SUDDOE_JWKS_TTL=           # 선택 · 기본 600(초)
SUDDOE_DEMO_TTL=           # 선택 · 기본 7200(초) · 데모 토큰 수명
SUDDOE_DEMO_PROGRAM=       # 선택 · 기본 예비창업패키지 · 데모 세션 사업
SUDDOE_DEMO_LIMIT=         # 선택 · 기본 200 · 데모 세션 상한
SUDDOE_DEMO_KEEP_SEC=      # 선택 · 기본 86400 · 데모 데이터 보존
SUDDOE_DEMO_PURGE_LIMIT=   # 선택 · 기본 50 · 한 번에 정리하는 데모 행 수

# ── GPU 워치독 (vLLM 경로일 때만) ─────────────────────────────────────
RUNPOD_API_KEY=            # 워치독 쓸 때 필수
RUNPOD_POD_ID=             # 워치독 쓸 때 필수
RUNPOD_REST=               # 선택 · 기본 https://rest.runpod.io/v1
SUDDOE_GPU_IDLE_MIN=       # 선택 · 기본 30(분) · 0 이면 워치독 비활성
SUDDOE_GPU_WARN_MIN=       # 선택 · 기본 5(분) · 종료 예고 시점
SUDDOE_GPU_CHECK_SEC=      # 선택 · 기본 60(초)
SUDDOE_GPU_START_SEC=      # 선택 · 기본 300(초) · 기동 대기 상한
SUDDOE_GPU_POLL_SEC=       # 선택 · 기본 5(초)
SUDDOE_GPU_WAKE_DAILY_CAP= # 선택 · 하루 기동 횟수 상한

# ── 서버 ─────────────────────────────────────────────────────────────
SUDDOE_PORT=               # 선택 · 기본 8080 · `python server/main.py` 직접 실행용
SUDDOE_HOST=               # 선택 · 기본 127.0.0.1
PORT=                      # Cloud Run 이 주입한다. 직접 설정하지 않는다
SUDDOE_JUDGE_HEARTBEAT_SEC=# 선택 · 기본 12(초) · SSE 하트비트 주기
SUDDOE_PROGRAM_TTL=        # 선택 · 기본 300(초) · 사업명 목록 캐시

# 컨테이너가 이미 박아둔 것: HF_HOME=/opt/hf · HF_HUB_OFFLINE=1 · TRANSFORMERS_OFFLINE=1

__pycache__/
*.pyc
.venv/
venv/
.env
.env.*
# 🔴 .gitignore 는 «줄 끝 주석»을 안 받는다. 같은 줄에 # 를 쓰면
#    패턴에 통째로 붙어 아무것도 안 걸린다 (2026-09-03 에 이걸로 한 번 놓쳤다)
!.env.example
*.log
.DS_Store
Thumbs.db
scripts/_stage0_report.json
scripts/_review_memo.txt
scripts/_test_out.txt

# UI 프로토타입 — 푸시하지 않음 (사용자 요청)
관리자_프로토타입*.html
*프로토타입*.html

# ── Stage 0 파생물 ──────────────────────────────────────────────
# 조 본문 전량 덤프(74MB). 원본 코퍼스를 JSON 으로 복제한 것이라 저장소에 두지 않는다.
# `python scripts/stage0_run.py` 로 언제든 재생성된다. 메타데이터는 _stage0_report.json 에 있다.
2026_Finance_DATA_FOR_RAG/_stage0_articles.json

# 파서 진단·측정의 **중간 산출물**만 제외한다. 검증 스크립트(*.py)는 문서가
# 실행 명령으로 참조하므로 저장소에 남긴다.
scripts/_work/_text_cache/
scripts/_work/_refs_*.json
scripts/_work/_precedence_prev.json
scripts/_work/_cdu.txt
scripts/_work/_붙임2_*.txt
scripts/_work/_stage0_articles_before.py

# ── 2026-08-31 추가 ─────────────────────────────────────────────
# 런타임 상태 — 팟 id 가 담긴다. 커밋할 것이 아니다
.claude/_runpod_open.json

# 재생성 가능한 대용량 산출물. 임베딩은 GPU 15분/$0.06 이면 다시 만든다
scripts/_work/emb.npy
scripts/_work/_stage2_chunks.jsonl
scripts/_work/*.bak
scripts/_work/*.bak2

# 스모크·진단 출력 (실측 근거가 아니라 그때그때 확인용)
scripts/_work/_score_smoke.jsonl
scripts/_work/_judge_result.jsonl
scripts/_work/_extraction_probe.json
scripts/_work/_rrf_tune_cache.pkl

# 스크린샷
*.png

# 세션 전용 하네스 (프론트-백엔드 간극 세션) — 로컬 전용
.claude/settings.local.json
.claude/_fe_be_session.json

# 백업 산출물
*.bak

# 커밋 메시지 임시파일 (git add -A 에 쓸려 들어간 적 있다)
_m.txt
_msg.tmp

# 주관기관 추출 중간 산출 (스크래치패드로 가야 할 것)
_orgs_*.json

# L3 기관 규정 업로드 원본 — 사용자 문서다. 저장소에 올리지 않는다
_l3_업로드/
